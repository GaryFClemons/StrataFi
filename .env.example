# Environment variables for StrataFi on one machine.
#
# `uv run python scripts/dev_setup.py` turns this file into .env:
# - a value written as __GENERATE_SECRET__ gets a random secret on first run and keeps it afterwards
# - ${NAME} inside a value is replaced with another variable's final value
# - values already in .env are kept
# Never commit .env, and never copy it between machines. scripts/local.py reads it, other host
# processes read it with `uv run --env-file .env ...`, and docker compose reads it from the repo
# root.

# --- Environment and paths (relative paths resolve from the repo root)
STRATAFI_ENV=dev
STRATAFI_LOG_LEVEL=INFO
STRATAFI_CONFIG_DIR=config
STRATAFI_CONFIG_OVERLAY=config/overlays/dev

# --- Identity: one person on one machine. The API checks identity tokens against this key
# pair's public key; the development sign-in, which the web app and the SDK use, signs them with
# its private key. Only scripts/dev_setup.py and the sign-in read the private key.
STRATAFI_IDENTITY_PUBLIC_KEY=data/keys/identity-signing.pub.pem
STRATAFI_IDENTITY_PRIVATE_KEY=data/keys/identity-signing.pem
STRATAFI_DEV_SIGN_IN_KEY=${STRATAFI_IDENTITY_PRIVATE_KEY}
# The worker signs its calls to the model gateway with it too.
STRATAFI_SERVICE_SIGNING_KEY=${STRATAFI_IDENTITY_PRIVATE_KEY}

# --- Postgres 16 with pgvector: compose's postgres service, or one of your own on this port
# (scripts/wsl/postgres.sh on Windows without Docker). The admin account is for bootstrap only;
# services connect as the stratafi role.
STRATAFI_PG_PORT=5442
STRATAFI_PG_ADMIN_USER=stratafi_admin
STRATAFI_PG_ADMIN_PASSWORD=__GENERATE_SECRET__
STRATAFI_PG_ADMIN_DSN=postgresql://${STRATAFI_PG_ADMIN_USER}:${STRATAFI_PG_ADMIN_PASSWORD}@127.0.0.1:${STRATAFI_PG_PORT}/postgres
STRATAFI_PG_PASSWORD=__GENERATE_SECRET__
STRATAFI_DATABASE_URL=postgresql://stratafi:${STRATAFI_PG_PASSWORD}@127.0.0.1:${STRATAFI_PG_PORT}/stratafi

# --- The model gateway (services/gateway), which serves Ollama's models. Empty: no gateway.
STRATAFI_MODEL_GATEWAY_URL=http://127.0.0.1:8091

# --- Artifacts: files under data/artifacts. With `s3` they go through an S3 API instead, such as
# compose's SeaweedFS (docker compose --profile seaweedfs up -d --wait). compose.yaml writes the
# key and secret into the store's identity file, a JSON document, so keep them to letters,
# digits, '-' and '_'.
STRATAFI_STORAGE__DRIVER=local
STRATAFI_S3_PORT=9100
STRATAFI_S3_ENDPOINT=http://127.0.0.1:${STRATAFI_S3_PORT}
STRATAFI_S3_ACCESS_KEY=stratafi-dev
STRATAFI_S3_SECRET_KEY=__GENERATE_SECRET__
STRATAFI_S3_BUCKET=stratafi
# The store's administrator, which only creates the bucket: the services' user above may use
# that bucket and nothing else. The API and the worker never read these.
STRATAFI_S3_ADMIN_ACCESS_KEY=stratafi-admin
STRATAFI_S3_ADMIN_SECRET_KEY=__GENERATE_SECRET__

# --- Optional services, each behind its own compose profile. Empty: not used. Start one, then
# set its address here:
# - ClamAV's clamd, for scan/clamav: `docker compose --profile clamav up -d --wait`, then
#   STRATAFI_CLAMAV_ADDRESS=127.0.0.1:3320 (the port below)
# - Apache Tika, for parse/tika: `docker compose --profile tika up -d --wait`, then
#   STRATAFI_TIKA_URL=http://127.0.0.1:9998 (the port below)
STRATAFI_CLAMAV_PORT=3320
STRATAFI_CLAMAV_ADDRESS=
STRATAFI_TIKA_PORT=9998
STRATAFI_TIKA_URL=

# --- Model tier tests (optional): an OpenAI-compatible endpoint, such as the gateway's
STRATAFI_TEST_MODEL_URL=
