{
  "name": "@stratafi/web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "budgets": "node scripts/check-budgets.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "api:generate": "openapi-typescript ../contracts/openapi.json -o src/lab/api/generated/schema.ts",
    "api:check": "openapi-typescript ../contracts/openapi.json -o src/lab/api/generated/schema.ts --check"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "echarts": "6.1.0",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.5"
  },
  "allowScripts": {
    "esbuild": false
  }
}
